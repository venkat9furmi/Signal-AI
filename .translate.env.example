# Translation layer. Copy to `.translate.env` (gitignored) and fill in.
# Everything here is optional: with no file at all, the /translate page runs
# on the offline stand-in and the continuous pipeline stays off.

# -- Gemini: live speech-to-speech translation ------------------------------
# A key from https://aistudio.google.com -> API keys. No card needed.
#
# This is the one that does what MMC wants: English commentary in, Greek or
# German VOICE out, over one socket, as it happens. 79 languages including
# el (Greek) and de (German), which the other adapter's live path does not
# carry.
#
# Free of charge on Google's free tier -- and the same page says free-tier
# input and output are "used to improve our products", so MMC's commentary
# becomes training data until somebody agrees otherwise. Worth knowing before
# a real match goes through it.
#
# The model is a PREVIEW. Google renames previews, which is why the name is a
# setting rather than compiled in.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-live-translate-preview

# Speak even when the audio is already in the target language. On by default:
# with it off, an English channel translated to English goes silent, which
# looks exactly like a broken session.
# GEMINI_ECHO_TARGET=1

# -- Camb AI: the recorded-clip chain, and its own live path ----------------
# From https://studio.camb.ai -> API. The ONLY place the key lives. It is
# never written into the control row the page can change, and the API never
# accepts or returns it, so no request can redirect which account is billed.
#
# Kept alongside Gemini on purpose: two adapters is what makes shadow mode a
# test bench rather than an integration. Note its LIVE path carries 14
# languages and neither Greek nor Italian; its clip path carries Greek on the
# mars-8.1 and mars-instruct models.
CAMB_API_KEY=

# Which model the /translate page uses: mock (offline, free, beeps),
# gemini (live only) or camb (clips and live).
# A provider with no key cannot be selected at all - the registry refuses it
# before any audio is captured, rather than failing on the first call.
QC_TRANSLATE_PROVIDER=mock

# What commentary is translated into.
QC_TRANSLATE_TARGET=en-us

# -- shadow mode: the /translate page ---------------------------------------
# Hard cap on audio sent per UTC day by shadow runs. Seeded from the database
# at startup, so a restart does not hand back a fresh allowance.
#
# WATCH THIS ONE. Camb free plan = 6 minutes of API speech-to-text IN TOTAL,
# once - not per day, not per month. A daily cap cannot protect a lifetime
# allowance, so 5 is set to survive one day of testing and no more. At 15 s a
# run that is ~20 runs, which is enough to judge whether the output is any
# good. Raise it only on a paid plan.
QC_SHADOW_DAILY_MINUTES=5

# How many seconds of a channel one recorded clip grabs.
QC_SHADOW_SECONDS=15

# -- live translation -------------------------------------------------------
# The realtime WebSocket, which is a different product from the three REST
# calls above: different languages, billed by the clock rather than per call.
#
# fast  takes audio almost at once, and carries the fourteen languages Camb
#       publishes for realtime.
# slow  carries more languages, but the docs document a cold boot of thirty
#       seconds or more before the session accepts any audio.
#
# WORTH KNOWING BEFORE YOU PICK A CHANNEL: it-it and el-gr are NOT in the
# published realtime list, which is MMC's Italian (9) and Greek (11) channels,
# 20 of 52. English, French, German and Portuguese (via pt-br) are covered.
# The page warns and still lets you try, because the docs never print the
# per-mode lists and so may simply be incomplete.
QC_LIVE_MODE=fast

# Hard ceiling on one live session, in seconds. This is not a guess at what is
# useful - it is what stops a session somebody opened and walked away from
# running for the four hours the protocol allows.
QC_LIVE_SECONDS=60

# How many live sessions at once. Leave at 1 on the free plan: Camb documents
# an API concurrency of 1, and a second session is otherwise refused by the far
# end only after audio has already started flowing.
QC_LIVE_CONCURRENT=1

# Voice and synthesis model for the spoken translation. Defaults are Camb's
# own: voice 147320 ("Gary") and their current fastest model. The page lists
# what the key can actually reach, which is worth checking before changing
# these - the docs deprecate the numeric language ids without printing the
# replacements.
# CAMB_VOICE_ID=147320
# CAMB_SPEECH_MODEL=mars-8.1-flash-beta
# CAMB_AUDIO_FORMAT=wav

# -- the continuous pipeline (separate from the page) -----------------------
# Transcribes claimed channels for the length of a match, rather than one clip
# on demand. Not needed for the /translate page. off | shadow | standard.
QC_TRANSLATE_MODE=off
QC_TRANSLATE_DAILY_MINUTES=60

# Point the adapter at a different host - used by the tests to run the whole
# path against a local fake. Leave unset in production.
# CAMB_API_BASE=https://client.camb.ai/apis
