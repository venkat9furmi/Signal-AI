# Translation layer. Copy to `.translate.env` (gitignored) and fill in.
# Everything here is optional: with no file at all the pipeline starts off.

# Camb AI key, from https://studio.camb.ai -> API. The ONLY place the key
# lives. It is never written into the control row the page can change, so no
# request to the page can redirect which account is billed.
CAMB_API_KEY=

# Starting mode: off | shadow | prod. The page can change this at runtime;
# this only sets what the recorder begins with after a restart.
#   off     nothing runs, no audio buffered, no credit spendable
#   shadow  runs on real commentary, stores everything, publishes nothing
#   prod    the same pipeline, with the output shown
QC_TRANSLATE_MODE=off

# Which model: mock (offline, free) or camb.
QC_TRANSLATE_PROVIDER=mock

# What everything is translated into.
QC_TRANSLATE_TARGET=en-us

# Hard cap on audio sent per UTC day. The free-credit guard.
QC_TRANSLATE_DAILY_MINUTES=60

# Point the adapter at a different host - used by the tests to run the whole
# path against a local fake. Leave unset in production.
# CAMB_API_BASE=https://client.camb.ai/apis
